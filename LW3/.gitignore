```gitignore
# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Distribution and build
build/
dist/
*.egg-info/

# Environment variables and secrets
.env
.env.*
!.env.example

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking and linting
.mypy_cache/
.ruff_cache/
.pyright/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Jupyter Notebook
.ipynb_checkpoints/

# Temporary files
*.tmp
*.bak
```
